      "html": "<span class=\"ds-badge\" style=\"--b-bg:#CAF0F8;--b-fg:#005f92\">Em Andamento</span> <span class=\"ds-badge\" style=\"--b-bg:#D1FAE5;--b-fg:#1F6B00\">Resolvido</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:var(--b-bg);color:var(--b-fg);font-family:Inter,system-ui,sans-serif;font-size:.88rem;font-weight:700;white-space:nowrap;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s}.ds-badge::before{content:\"\";width:8px;height:8px;border-radius:50%;background:currentColor}.ds-badge:hover{transform:translateY(-4px);box-shadow:0 0 0 4px rgba(0,180,216,.55)}"
