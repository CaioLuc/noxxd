  "components": [
    {
      "name": "NOXXD Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Square gold action on the teal world; inverts to teal on hover.",
      "html": "<button class=\"ds-btn-primary\">VER PROJETO</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;padding:14px 32px;background:#C8975D;color:#0E363E;font-family:Oswald,'Arial Narrow',sans-serif;font-size:1.1rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;border:2px solid #C8975D;border-radius:0;cursor:pointer;transition:background-color .15s ease-in-out,color .15s ease-in-out,border-color .15s ease-in-out,transform .15s ease-in-out}.ds-btn-primary:hover,.ds-btn-primary:focus-visible{background:#1B5E6B;color:#C8975D;border-color:#D8A76D;transform:translateY(-2px);outline:none}.ds-btn-primary:active{background:#154B56;transform:none}"
    },
    {
      "name": "NOXXD Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary square action; fills gold on hover.",
      "html": "<button class=\"ds-btn-outline\">FALE CONOSCO</button>",
      "css": ".ds-btn-outline{display:inline-flex;padding:14px 32px;background:transparent;color:#C8975D;font-family:Oswald,'Arial Narrow',sans-serif;font-size:1.1rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;border:2px solid #C8975D;border-radius:0;cursor:pointer;transition:background-color .15s,color .15s,transform .15s}.ds-btn-outline:hover,.ds-btn-outline:focus-visible{background:#C8975D;color:#0E363E;transform:translateY(-2px)}.ds-btn-outline:focus-visible{outline:2px solid #D8A76D;outline-offset:4px}"
    },
    {
      "name": "NOXXD Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Square stack/technology tag on teal.",
      "html": "<span class=\"ds-tag\">LARAVEL</span>",
      "css": ".ds-tag{display:inline-block;padding:4px 10px;background:rgba(200,151,93,.15);border:1px solid #C8975D;color:#C8975D;font-family:'Josefin Sans',sans-serif;font-size:.8rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;border-radius:0}"
    },
    {
      "name": "Pixel Card",
      "kind": "card",
      "refersTo": "pixel-card",
      "description": "Square gold-bordered card with 8-bit corner tabs; lifts 4px on hover.",
      "html": "<article class=\"ds-pixel-card\"><h3>URBIS</h3><p>Zeladoria urbana com app e painel.</p></article>",
      "css": ".ds-pixel-card{position:relative;max-width:320px;background:#154B56;border:2px solid #C8975D;padding:32px 24px;color:#F5F7F8;font-family:'Josefin Sans',sans-serif;transition:transform .25s ease-in-out,border-color .25s ease-in-out}.ds-pixel-card h3{font-family:Oswald,sans-serif;color:#C8975D;letter-spacing:.06em;margin:0 0 8px}.ds-pixel-card::before,.ds-pixel-card::after{content:\"\";position:absolute;left:-3px;width:6px;height:6px;background:#C8975D;box-shadow:calc(100% + 0px) 0 0 #C8975D}.ds-pixel-card::before{top:-3px}.ds-pixel-card::after{bottom:-3px}.ds-pixel-card:hover{transform:translateY(-4px);border-color:#D8A76D}"
    },
    {
      "name": "Case Frame Bar",
      "kind": "nav",
      "refersTo": "frame-bar",
      "description": "Sticky NOXXD bar over every case page: back link, PT/EN switch, gold contact.",
      "html": "<header class=\"ds-bar\"><a class=\"ds-back\" href=\"#\">&larr; NOXXD</a><div class=\"ds-actions\"><span class=\"ds-lang\"><button aria-pressed=\"true\">PT</button><button aria-pressed=\"false\">EN</button></span><a class=\"ds-contact\" href=\"#\">CONTATO</a></div></header>",
      "css": ".ds-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:60px;padding:0 16px;background:#154B56;border-bottom:2px solid #C8975D;font-family:Oswald,'Arial Narrow',sans-serif;text-transform:uppercase;letter-spacing:.08em}.ds-back{color:#F5F7F8;text-decoration:none;font-weight:600;font-size:.95rem}.ds-back:hover,.ds-back:focus-visible{color:#C8975D}.ds-actions{display:flex;align-items:center;gap:14px}.ds-lang{display:inline-flex;gap:2px;border:1px solid #C8975D;padding:2px}.ds-lang button{border:0;background:transparent;color:#D0C0A7;font:inherit;font-size:.8rem;font-weight:700;padding:6px 9px;cursor:pointer;line-height:1}.ds-lang button:hover{color:#F5F7F8}.ds-lang button[aria-pressed=\"true\"]{background:#C8975D;color:#0E363E}.ds-contact{padding:9px 18px;background:#C8975D;color:#0E363E;border:2px solid #C8975D;font-size:.85rem;font-weight:700;text-decoration:none;transition:background-color .15s,color .15s}.ds-contact:hover,.ds-contact:focus-visible{background:transparent;color:#C8975D}"
