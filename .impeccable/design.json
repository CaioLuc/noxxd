      "html": "<ol class=\"ds-matrix\"><li class=\"ok\">NR-06</li><li class=\"due\">NR-10</li><li class=\"late\">NR-35</li></ol>",
      "css": ".ds-matrix{display:grid;grid-template-columns:repeat(3,56px);gap:6px;list-style:none;padding:16px;margin:0;background:#13375e;border-radius:10px}.ds-matrix li{display:grid;place-items:center;aspect-ratio:1;border-radius:4px;background:color-mix(in srgb,var(--c) 22%,#0B2545);border:1px solid color-mix(in srgb,var(--c) 70%,transparent);color:#fff;font:600 .75rem Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;transition:transform .25s cubic-bezier(.16,1,.3,1),background-color .25s}.ds-matrix li:hover{transform:scale(1.12);background:var(--c);color:#020617}.ds-matrix .ok{--c:#16a34a}.ds-matrix .due{--c:#d97706;background:color-mix(in srgb,var(--c) 78%,#0B2545);color:#020617}.ds-matrix .late{--c:#dc2626;background:color-mix(in srgb,var(--c) 72%,#0B2545)}.ds-matrix .late:hover{color:#fff}"
    }
